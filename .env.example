# Copy this file to .env and fill in your OpenAI key for local development
GROQ_API_KEY=your_groq_api_key_here

# Optional: Get a key at: https://console.groq.com
# Optional: override the default SQLite DB location
TASKPLANNER_DB_URL=sqlite:///./plans.db

# Examples:
# TASKPLANNER_DB_URL=postgresql://user:pass@localhost:5432/taskplanner
